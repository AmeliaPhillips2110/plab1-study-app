# Copy to .env.local (never commit real keys)
# Use the Supabase Project URL and the anon (public) key only — never the service role key.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: set when deploying to GitHub Pages under a project site path
# VITE_BASE=/plab1-study-app/
